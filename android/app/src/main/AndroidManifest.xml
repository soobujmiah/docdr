<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        DocDr permission policy (docs/SECURITY_PRIVACY.md):
        "Request only the Android permissions required by the active feature."

        NO permissions are declared at the P0 foundation stage. Add CAMERA only
        when the scanner feature lands, and add storage permissions only if the
        Storage Access Framework proves insufficient.

        This deliberately pre-empts RGEN finding RGEN-05, which recorded
        READ_EXTERNAL_STORAGE, WRITE_EXTERNAL_STORAGE, MANAGE_EXTERNAL_STORAGE
        and INTERNET. Do NOT reintroduce them:
          - MANAGE_EXTERNAL_STORAGE is a Play policy barrier and is not needed
            by a modern document app; use SAF or MediaStore instead.
          - INTERNET contradicts DocDr's local-first trust claim unless a
            documented, user-visible feature requires it.
    -->

    <application
        android:label="DocDr"
        android:name="${applicationName}">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!--
        Queries needed by the Flutter engine's ProcessText plugin. Declared
        explicitly because Android 11+ restricts package visibility.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
